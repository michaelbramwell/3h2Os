@baseUrl = http://localhost:8000

### Get Dashboard (HTML)
GET {{baseUrl}}/

### Get Plan (JSON)
GET {{baseUrl}}/api/plan.json

### Get Context (JSON)
GET {{baseUrl}}/api/context.json

### Get Actuals (JSON)
GET {{baseUrl}}/api/actuals.json

### POST Garmin Token (Auth)
POST {{baseUrl}}/api/garmin/token
Content-Type: application/json

{
    "email": "user@example.com",
    "password": "password123"
}

### Sync Garmin Activities (Requires Token)
# 1. First get the token from above or your browser local storage
# 2. Add it to the header below
POST {{baseUrl}}/api/integrations/garmin/sync?days=7
X-Garmin-Token: <INSERT_BASE64_TOKEN_HERE>
Content-Type: application/json

### Get Context Markdown
GET {{baseUrl}}/api/context/markdown

### Update Weight (POST)
POST {{baseUrl}}/api/context/weight
Content-Type: application/json

{
    "weight": 98.5
}

### Post Actuals (Batch)
POST {{baseUrl}}/api/actuals
Content-Type: application/json

[
  {
    "date": "2026-01-20",
    "name": "Tempo Run with Splits",
    "type": "running",
    "distance_m": 5000,
    "duration_s": 1200,
    "activityId": 999999,
    "average_pace_m_s": 4.16,
    "average_hr": 165,
    "splits": [
        {"distance": 1000, "averageSpeed": 4.1, "averageHR": 160},
        {"distance": 1000, "averageSpeed": 4.2, "averageHR": 165},
        {"distance": 1000, "averageSpeed": 4.15, "averageHR": 170},
        {"distance": 1000, "averageSpeed": 4.2, "averageHR": 172},
        {"distance": 1000, "averageSpeed": 4.15, "averageHR": 175}
    ]
  }
]

### Update Plan (POST)
# Warning: This will overwrite the current plan in the database/file!
POST {{baseUrl}}/api/plan.json
Content-Type: application/json

[
  {
    "weekStarting": "2026-01-05",
    "days": {
      "Mon": {
        "date": "2026-01-05",
        "workouts": []
      },
      "Tue": {
        "date": "2026-01-06",
        "workouts": [
          {
            "name": "Test Update 8k",
            "type": "Easy",
            "distance_m": 8000.0,
            "timeOfDay": "AM"
          }
        ]
      }
    }
  }
]

### Create Plan (POST /plans)
# Creates a new INACTIVE plan.
POST {{baseUrl}}/api/plans
Content-Type: application/json

{
  "title": "Fresh Start Plan 2026",
  "weeks": [
    {
      "weekStarting": "2026-03-01",
      "days": {
        "Mon": {
          "date": "2026-03-01",
          "workouts": []
        }
      }
    }
  ]
}

### Activate Plan (PUT)
# Replace {plan_id} with the ID returned from creation
PUT {{baseUrl}}/api/plans/1/activate

### Update Workout (PUT)
# Replace {workout_id} with actual ID
PUT {{baseUrl}}/api/workouts/999
Content-Type: application/json

{
    "name": "Edited Workout",
    "distance_m": 5000,
    "description": "Updated via API"
}

### Delete Workout (DELETE)
# Replace {workout_id} with actual ID
DELETE {{baseUrl}}/api/workouts/999
