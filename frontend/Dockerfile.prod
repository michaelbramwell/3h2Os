# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Accept build arguments for env vars
ARG VITE_API_URL
ARG VITE_AUTH_AUTHORITY
ARG VITE_AUTH_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY
ENV VITE_AUTH_CLIENT_ID=$VITE_AUTH_CLIENT_ID

COPY . .
RUN npm run build

# Production stage
FROM caddy:alpine

# Copy built assets
COPY --from=builder /app/dist /srv

# Create Caddyfile for SPA routing
RUN echo $':80 {\n\
    root * /srv\n\
    encode gzip\n\
    try_files {path} /index.html\n\
    file_server\n\
}' > /etc/caddy/Caddyfile

EXPOSE 80
