@baseUrl = http://localhost:8000

### Get Dashboard (HTML)
GET {{baseUrl}}/

### Get Plan (JSON)
GET {{baseUrl}}/plan.json

### Get Context (JSON)
GET {{baseUrl}}/context.json

### Get Actuals (JSON)
GET {{baseUrl}}/actuals.json

### Update Plan (POST)
# Warning: This will overwrite the current plan in the database/file!
POST {{baseUrl}}/plan.json
Content-Type: application/json

[
  {
    "weekStarting": "2026-01-05",
    "days": {
      "Mon": {
        "date": "2026-01-05",
        "workouts": []
      },
      "Tue": {
        "date": "2026-01-06",
        "workouts": [
          {
            "name": "Test Update 8k",
            "type": "Easy",
            "distance_m": 8000.0,
            "timeOfDay": "AM"
          }
        ]
      }
    }
  }
]

### Create Plan (POST /plans)
# Creates a new INACTIVE plan.
POST {{baseUrl}}/plans
Content-Type: application/json

{
  "title": "Fresh Start Plan 2026",
  "weeks": [
    {
      "weekStarting": "2026-03-01",
      "days": {
        "Mon": {
          "date": "2026-03-01",
          "workouts": []
        }
      }
    }
  ]
}

### Activate Plan (PUT)
# Replace {plan_id} with the ID returned from creation
PUT {{baseUrl}}/plans/1/activate
