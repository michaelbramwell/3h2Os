# =============================================================================
# App / Infrastructure (Docker)
# =============================================================================
IMAGE_NAME=michaelbramwell/3h2os
# Immutable image tag. The deploy workflow sets this to the commit SHA.
# Leave as "latest" for local/dev convenience.
IMAGE_TAG=latest
DOMAIN=
ACME_EMAIL=
VOLUME_PATH=

# =============================================================================
# Database
# =============================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>
# If POSTGRES_PASSWORD contains reserved URL characters (e.g. @, :, /, ?, #),
# set POSTGRES_PASSWORD_ENCODED to the percent-encoded version for use in
# DATABASE_URL (docker-compose.prod.yml builds the URL from components).
# Leave unset if the password has no special characters.
# POSTGRES_PASSWORD_ENCODED=

# =============================================================================
# Auth (Keycloak / OIDC)
# =============================================================================
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KC_HTTP_RELATIVE_PATH=/auth
IDP_URL=http://localhost:8080
IDP_REALM=running-realm
# Set to "false" to disable JWT signature verification in local dev (no Keycloak needed)
JWT_VERIFY_SIGNATURE=true
SECRET_KEY=change-me-in-production
# Dev only: fallback username when no JWT is present (do not set in production)
# DEFAULT_USERNAME=runner
# DEFAULT_PASSWORD=

# OIDC identity validation (production-strong).
# If set, the JWT `iss`, `aud`, and `azp` claims are validated.
# Leave unset in dev to skip these checks; production should set all three.
# Default issuer is derived from IDP_URL/IDP_REALM if OIDC_ISSUER is unset.
OIDC_ISSUER=http://localhost:8080/realms/running-realm
OIDC_AUDIENCE=account
OIDC_AUTHORIZED_CLIENT_ID=3h2os-frontend

# TrustedHostMiddleware allowlist (comma-separated). Falls back to DOMAIN.
TRUSTED_HOSTS=3h2os.com,www.3h2os.com

# =============================================================================
# Strava OAuth
# =============================================================================
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback
# Secret used to sign/verify the OAuth state token (HMAC-SHA256). Use a long random string.
STRAVA_STATE_SECRET=
# Optional: number of days to keep cached activity streams (default 30)
STRAVA_STREAMS_MAX_AGE_DAYS=30
# Webhook verification token — must match what you register with Strava
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Webhook URL secret — long random string appended to webhook path (e.g. /strava/webhook/{secret}).
# Register the full URL with Strava. If empty, falls back to /strava/webhook (no secret).
STRAVA_WEBHOOK_SECRET=
# How often (in seconds) the webhook worker polls for pending Strava webhook jobs.
# Default: 5 seconds.
STRAVA_WEBHOOK_WORKER_INTERVAL_SECS=5

# =============================================================================
# App
# =============================================================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Optional: set DOMAIN to enable HTTPS redirect middleware
# DOMAIN=example.com
